---
import Navbar from '../components/Navbar.astro';
import Layout from '../layouts/Layout.astro';
// import Card from '../components/Card.astro';
import bgHome from '../assets/BG.png'
import bg2Home from '../assets/BG-2.png'
import dotHome from '../assets/dot.png'
import CardSlider from '../components/CardSlider';
import amtrapIcon from '../assets/clients-icons/amtrap.svg'
import navidadUyIcon from '../assets/clients-icons/navidad_uy.svg'
import escuelaEnfermariaIcon from '../assets/clients-icons/escuela_de_enfermería.svg'
import firbouyIcon from '../assets/clients-icons/firbouy.svg'
import landforceIcon from '../assets/clients-icons/landforce.svg'
import levandeIcon from '../assets/clients-icons/levande.svg'
import yellowIcon from '../assets/clients-icons/yellow.svg'
import pisosAlfombrasIcon from '../assets/clients-icons/pisos_y_alfombras.svg'

const items = [
	{
		title: 'Servicios',
		url: ''
	},
	{
		title: 'Trabajo',
		url: ''
	},
	{
		title: 'Nosotros',
		url: ''
	},
	{
		title: 'Contactanos',
		url: ''
	},
];

const title = "Mantis - servicios web de alta calidad";

---

<Layout title={title}>
	<main>
		<Navbar items={items}/>
		<div style={{ background: `url(${bgHome.src})` }} class="bg-home-image">
			<div class="relative flex justify-center items-center h-full">
				<img class="absolute w-[50%] 2xl:w-[35%]" src="./ISOLOGO-bg.png" alt="">
				<img class="absolute w-[75%] 2xl:w-[55%]" src="./MANTIS-bg.png" alt="">
			</div>
		</div>
		<div style={{ background: `url(${bg2Home.src})` }} class="bg-home-2-image">
			<div class="relative flex justify-center items-center h-full">
				<div class="absolute flex flex-col justify-between w-[55rem] h-[300px] p-7 bg-black/30 text-white">
					<span class="text-6xl font-extrabold font-aktiv-grotesk">
						Diseñamos con <span class="text-main-green">creatividad</span>, <br>
						programamos con <span class="text-main-green">agilidad</span>.
					</span>
					<div class="flex items-center">
						<div class="">Servicios</div>
						<img class="mt-1 px-2.5" src={dotHome.src} alt="">
						<div class="">Trabajo</div>
						<img class="mt-1 px-2.5" src={dotHome.src} alt="">
						<div class="">Nosotros</div>
						<img class="mt-1 px-2.5" src={dotHome.src} alt="">
					</div>
				</div>
			</div>
		</div>
		<div style={{ background: `url(${bgHome.src})` }} class="flex flex-col justify-center items-center bg-home-image-sections text-white pb-10">
			<CardSlider client:only="react"/>			
		</div>
		<section style={{ background: `url(${bgHome.src})` }} class="text-white flex flex-col items-center pb-20">
			<div class="text-center text-7xl font-extrabold font-aktiv-grotesk pt-16 mb-20 2xl:mb-32">Nuestros clientes</div>
			<div class="grid grid-cols-2 gap-8 bg-black/50 p-10 w-[845px]">
				<div class="bg-black flex justify-center items-center h-[300px]"><img src={amtrapIcon.src} alt=""></div>
				<div class="bg-black flex justify-center items-center h-[300px]"><img src={navidadUyIcon.src} alt=""></div>
				<div class="bg-black flex justify-center items-center h-[300px]"><img src={escuelaEnfermariaIcon.src} alt=""></div>
				<div class="bg-black flex justify-center items-center h-[300px]"><img src={firbouyIcon.src} alt=""></div>
				<div class="bg-black flex justify-center items-center h-[300px]"><img src={landforceIcon.src} alt=""></div>
				<div class="bg-black flex justify-center items-center h-[300px]"><img src={levandeIcon.src} alt=""></div>
				<div class="bg-black flex justify-center items-center h-[300px]"><img src={yellowIcon.src} alt=""></div>
				<div class="bg-black flex justify-center items-center h-[300px]"><img src={pisosAlfombrasIcon.src} alt=""></div>
			</div>
		</section>
		<section style={{ background: `url(${bgHome.src})` }} class="bg-home-2-image text-white flex flex-col justify-center items-center">
			<div class="w-[896px] text-green-500 font-bold font-aktiv-grotesk space-y-5">
				<div class="w-full text-6xl">Hablemos</div>
				<p class="text-white text-2xl font-normal">Llena el formulario y te contactaremos lo antes posible.</p>
				<div class="bg-black/50 h-[391px]">
					<form class="py-7 px-16 space-y-7 text-right text-white font-normal">
						<input name="nombre" class="w-full outline-none bg-transparent border-b-2 placeholder:font-semibold placeholder:capitalize py-1" type="text" placeholder="nombre*">
						<input name="emprendimiento" class="w-full outline-none bg-transparent border-b-2 placeholder:font-semibold placeholder:capitalize py-1" type="text" placeholder="emprendimiento*">
						<div class="flex space-x-24">
							<input name="telefono" class="w-1/2 outline-none bg-transparent border-b-2 placeholder:font-semibold placeholder:capitalize py-1" type="text" placeholder="teléfono*">
							<input name="email" type="email" class="w-1/2 outline-none bg-transparent border-b-2 placeholder:font-semibold placeholder:capitalize py-1" type="text" placeholder="email*">
						</div>
						<textarea name="descripcion_proyecto" class="w-full outline-none bg-transparent border-b-2 placeholder:font-semibold placeholder:capitalize py-1" id="" cols="30" rows="2" placeholder="cuéntanos sobre tu proyecto*"></textarea>
						<button class="outline-none bg-green-500 w-[223px] h-[55px] rounded-full text-xl text-white" type="submit">Enviar</button>
					</form>
				</div>
			</div>
		</section>

	</main>
</Layout>

<style>
	.bg-home-image{
		height: 94vh;
		width: 100%;
	}
	.bg-home-image-sections{
		height: 110vh;
		width: 100%;
	}
	.bg-home-2-image{
		height: 100vh;
		width: 100%;
	}
</style>
